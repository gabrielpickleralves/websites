# TTS 后端选择（可选，自动检测）
# edge = Edge TTS（微软在线，推荐，需 pip3 install edge-tts）
# mac  = macOS 系统自带 say 命令（离线）
TTS_BACKEND=edge

# Edge TTS 音色（中文可选）:
#   zh-CN-XiaoxiaoNeural  温暖女声（默认）
#   zh-CN-YunyangNeural   专业男声
#   zh-CN-YunxiNeural     活泼男声
#   zh-CN-XiaoyiNeural    活泼女声
TTS_VOICE=zh-CN-XiaoxiaoNeural

# 语速调整（Edge TTS: 百分比，如 +10% / -10%）
TTS_RATE=+0%

# edge-tts 可执行文件路径（可选，自动查找）
# EDGE_TTS_PATH=/Users/xxx/Library/Python/3.9/bin/edge-tts
